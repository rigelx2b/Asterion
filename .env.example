# Copy to .env and fill in. .env is gitignored; this example file is committed.

# Tiingo EOD API token (US market) — https://www.tiingo.com/account/api/token
TIINGO_API_KEY=

# 공공데이터포털 「금융위원회_주식시세정보」 일반 인증키 (KR market)
# Use the Decoding key (not the URL-encoded Encoding key); the client encodes it.
DATA_GO_KR_SERVICE_KEY=
